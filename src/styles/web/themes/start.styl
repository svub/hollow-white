.page.start
  text-align center
  // asset('start-background.jpg')
  assetx('start-background', 'jpg', 2)
  background-size cover
  background-position center
  // iOS Safari does not resolve `min-height: 100%` through the stretched
  // flex parents (html > body > main), so the page collapsed to its content
  // height. Give the start page an explicit viewport height instead.
  // 100dvh follows the visible area when Safari's toolbars show/hide.
  min-height 100vh
  min-height 100dvh

  .title
    flex 2
    flex-column()
    justify-items center

    .logo
      asset('start-logo.svg', 300px, 266px)
      margin auto
    h1
      display none

  .buttons
    flex 1
    flex-column()
    justify-content flex-end
    padding-bottom 26px

    .status
      @extend .small
      margin-bottom 20px

    button
      min-height 2.5em

      &.start, &.continue
        @extends .pill-button
        margin-bottom 18px

      &.options, &.credits, &.imprint
        @extends .text-button
        display block
        font-size 16px
        font-weight 300
        letter-spacing 1.25px
        margin-bottom 18px
        opacity .75

      &.options
        display none

// Phones: draw the start background edge to edge. App.vue adds
// `page-<name>` to <html> and switches the viewport to viewport-fit=cover on
// the start page, so the page may draw under the status bar and the home
// indicator / Safari toolbar. The image sits on a fixed layer that is as tall
// as the large viewport (100lvh), so it also fills the area behind Safari's
// toolbars; the root background is a fallback for overscroll. Wider screens
// keep the 450px column (the image is portrait and would be upscaled).
@media (max-width: maxWidth)
  for theme in themes
    base = s("/assets/%s/start-background", unquote(theme))
    html.{theme}.page-start, html.{theme}.page-start body::before
      background-image url(s("%s.jpg", base))
      background-image -webkit-image-set(url(s("%s.jpg", base)) 1x, url(s("%s@2x.jpg", base)) 2x)
      background-image image-set(url(s("%s.jpg", base)) 1x, url(s("%s@2x.jpg", base)) 2x)

  // Edge colours of the image (top / bottom rows). Safari 26 tints the
  // status bar and toolbar areas from the page colours, so they must not be
  // black here; App.vue also uses --startTop as theme-color.
  html.dark-theme.page-start
    --startTop #2e424f
    --startBottom #19252e
  html.light-theme.page-start
    --startTop #d6e0e6
    --startBottom #ccd1d6

  html.page-start
    background-color var(--startBottom)

  // transparent so Safari does not pick this fixed layer's colour for the bars
  html.page-start body::before
    background-color transparent

  html.page-start, html.page-start body::before
    background-repeat no-repeat
    background-size cover
    background-position center

  html.page-start body::before
    content ''
    position fixed
    top 0
    left 0
    right 0
    height 100vh
    height 100lvh
    z-index -1
    pointer-events none

  html.page-start body, html.page-start main
    background transparent

  html.page-start .page.start
    background-image none

    .buttons
      padding-bottom calc(26px + env(safe-area-inset-bottom))
