.page.start
  text-align center
  // asset('start-background.jpg')
  assetx('start-background', 'jpg', 2)
  background-size cover
  background-position center
  // iOS Safari does not resolve `min-height: 100%` through the stretched
  // flex parents (html > body > main), so the page collapsed to its content
  // height. Give the start page an explicit viewport height instead.
  // 100dvh follows the visible area when Safari's toolbars show/hide.
  min-height 100vh
  min-height 100dvh

  .title
    flex 2
    flex-column()
    justify-items center

    .logo
      asset('start-logo.svg', 300px, 266px)
      margin auto
    h1
      display none

  .buttons
    flex 1
    flex-column()
    justify-content flex-end
    padding-bottom 26px

    .status
      @extend .small
      margin-bottom 20px

    button
      min-height 2.5em

      &.start, &.continue
        @extends .pill-button
        margin-bottom 18px

      &.options, &.credits, &.imprint
        @extends .text-button
        display block
        font-size 16px
        font-weight 300
        letter-spacing 1.25px
        margin-bottom 18px
        opacity .75

      &.options
        display none

// Phones: put the start background on the root element instead of on
// .page.start. The root background paints the whole canvas, so on iOS Safari
// it also shows behind the status bar, the translucent toolbars / home
// indicator and during overscroll, where a background on .page.start left
// black bars. Wider screens keep the 450px column (the image is portrait and
// would be upscaled). App.vue sets `page-<name>` on <html> for this.
@media (max-width: maxWidth)
  for theme in themes
    base = s("/assets/%s/start-background", unquote(theme))
    html.{theme}.page-start
      background-color #000
      background-image url(s("%s.jpg", base))
      background-image -webkit-image-set(url(s("%s.jpg", base)) 1x, url(s("%s@2x.jpg", base)) 2x)
      background-image image-set(url(s("%s.jpg", base)) 1x, url(s("%s@2x.jpg", base)) 2x)
      background-repeat no-repeat
      background-size cover
      background-position center

  html.page-start body, html.page-start main
    background transparent

  html.page-start .page.start
    background-image none
